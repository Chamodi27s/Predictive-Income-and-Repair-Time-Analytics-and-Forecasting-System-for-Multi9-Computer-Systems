   ],
   "source": [
    "# Load model and encoders\n",
    "model = joblib.load(\"best_model.pkl\")\n",
    "encoders = joblib.load(\"encoders.pkl\")\n",
    "\n",
    "def predict_repair(new_job):\n",
    "    date_in = datetime.strptime(new_job['Date_In'], \"%Y-%m-%d\")\n",
    "    \n",
    "    features = {}\n",
    "    for col in categorical_cols:\n",
    "        le = encoders[col]\n",
    "        if new_job[col] in le.classes_:\n",
    "            features[col] = le.transform([new_job[col]])[0]\n",
    "        else:\n",
    "            features[col] = -1  # unseen category\n",
    "    \n",
    "    # Add date features\n",
    "    features['Year'] = date_in.year\n",
    "    features['Month'] = date_in.month\n",
    "    features['Day'] = date_in.day\n",
    "    \n",
    "    X_new = pd.DataFrame([features])\n",
    "    \n",
    "    pred_days = model.predict(X_new)[0]\n",
    "    pred_days_rounded = round(pred_days)\n",
    "    completion_date = date_in + timedelta(days=pred_days_rounded)\n",
    "    \n",
    "    return pred_days_rounded, completion_date.strftime(\"%Y-%m-%d\")\n",
    "\n",
    "# Example\n",
    "new_job = {\n",
    "    \"Date_In\": \"2026-03-07\",\n",
    "    \"Device_Type\": \"Desktop\",\n",
    "    \"Item_Model\": \"Dell 5490\",\n",
    "    \"Fault_Description\": \"No power\",\n",
    "    \"Technician\": \"Pradeep\",\n",
    "    \"Repair_Path\": \"In-House\",\n",
    "    \"Warranty\": \"No\",\n",
    "    \"Solution\": \"Motherboard repair\"\n",
    "}\n",
    "\n",
    "duration, completion_date = predict_repair(new_job)\n",
    "print(\"Predicted Duration (days):\", duration)\n",
    "print(\"Expected Completion Date:\", completion_date)"
   ]
  },
